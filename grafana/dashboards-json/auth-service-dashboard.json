{
  "dashboard": {
    "id": null,
    "title": "Auth Service Metrics",
    "tags": ["auth", "microservices"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Auth Request Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(auth_requests_total[5m]))",
            "legendFormat": "Total Auth Requests",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Auth Requests by Endpoint",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum by (endpoint) (rate(auth_requests_total[5m]))",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Login Success Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(auth_requests_total{endpoint=\"/login\",status=\"200\"}[5m])) / sum(rate(auth_requests_total{endpoint=\"/login\"}[5m])) * 100",
            "legendFormat": "Success Rate",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "id": 4,
        "title": "Token Verification Rate",
        "type": "timeseries",
        "targets": [
          {
            "expr": "sum(rate(auth_requests_total{endpoint=\"/verify\"}[5m]))",
            "legendFormat": "Token Verifications",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}
      },
      {
        "id": 5,
        "title": "Auth Request Duration",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(auth_request_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "min": 0
          }
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s"
  }
}